# Domínio público de produção. Enquanto estiver vazio, a página não publica
# canonical nem hreflang absolutos.
# Exemplo: https://reevue.com
NEXT_PUBLIC_SITE_URL=

# Formulários de interesse. Os dois podem apontar para o mesmo Google Form.
# Deixe vazio para mostrar "cadastro disponível em breve" e não inventar um link.
NEXT_PUBLIC_GOOGLE_FORM_URL_PT=
NEXT_PUBLIC_GOOGLE_FORM_URL_ES=

# Opcionais. O rodapé só mostra contato e redes quando houver um valor real.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
