# Public production domain. While empty, the page does not publish
# absolute canonical or hreflang URLs.
# Example: https://reevue.com
NEXT_PUBLIC_SITE_URL=reevue.com.br

# Analytics page. Server-only (no NEXT_PUBLIC_ prefix). Checked only on the server.
ANALYTICS_PASSWORD=idaho

# Contact form. Server-only (no NEXT_PUBLIC_ prefix).
# Local development (npm run dev) ignores these and appends each submission to
# data/contacts.xls, creating that file when it does not exist.
# Production (npm start, Docker, Vercel) posts to the deployed Apps Script
# web app (scripts/google-sheet.gs). SECRET in the script must match.
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=

# Google Analytics 4 measurement ID. Leave empty to omit the tag.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Social icons stay visible. Each one becomes a link only when a real URL is set.
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=
