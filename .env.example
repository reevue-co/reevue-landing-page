# Public production domain. While empty, the page does not publish
# absolute canonical or hreflang URLs.
# Example: https://reevue.com
NEXT_PUBLIC_SITE_URL=

# Interest forms. Both may point to the same Google Form.
# Leave empty to show "registration available soon" and avoid inventing a link.
NEXT_PUBLIC_GOOGLE_FORM_URL_PT=
NEXT_PUBLIC_GOOGLE_FORM_URL_ES=

# Optional. The footer shows contact and social links only when a real value is set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
