# Public production domain. While empty, the page does not publish
# absolute canonical or hreflang URLs.
# Example: https://reevue.com
NEXT_PUBLIC_SITE_URL=reevue.com.br

# Contact form -> Google Sheet. Server-only (no NEXT_PUBLIC_ prefix).
# URL of the deployed Apps Script web app (scripts/google-sheet.gs) and the
# same secret you set in the script's SECRET property. See README.
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=

# Google Analytics 4 measurement ID. Leave empty to omit the tag.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Social icons stay visible. Each one becomes a link only when a real URL is set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
