# Public production domain. While empty, the page does not publish
# absolute canonical or hreflang URLs.
# Example: https://reevue.com
NEXT_PUBLIC_SITE_URL=reevue.com.br

# Interest forms. Any of them may point to the same Google Form.
# English falls back to the Portuguese URL, then the Spanish URL.
# Leave all empty to show "registration available soon" and avoid inventing a link.
NEXT_PUBLIC_GOOGLE_FORM_URL_PT=
NEXT_PUBLIC_GOOGLE_FORM_URL_ES=
NEXT_PUBLIC_GOOGLE_FORM_URL_EN=

# Google Analytics 4 measurement ID. Leave empty to omit the tag.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Social icons stay visible. Each one becomes a link only when a real URL is set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
